# Database configuration (PostgreSQL for production, SQLite for local dev)
# Local SQLite default: sqlite+aiosqlite:///./data.db
# PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/trakt_sync
DATABASE_URL=sqlite+aiosqlite:///./data.db

# Trakt API credentials (from https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
TRAKT_REDIRECT_URI=http://localhost:8000/auth/trakt/callback

# TMDb API key for supplemental movie resolution (optional)
TMDB_API_KEY=

# Secret key for encrypting stored OAuth tokens and session validation
SECRET_KEY=generate_a_random_32_byte_secret_key_here_for_fernet_or_app

# Sync & Scheduler settings
SYNC_INTERVAL_MINUTES=15
LETTERBOXD_USERNAME=
